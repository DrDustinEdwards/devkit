{
  "name": "@dustinedwards/devkit",
  "version": "0.18.1",
  "private": true,
  "description": "Shared tooling for the Dustin Edwards repositories. As a package: the shared test helpers and the shared checks, installed by git tag. The Renovate policy and the reusable workflows in this repository are not part of the package.",
  "type": "module",
  "exports": {
    "./github": {
      "types": "./testing/github.d.mts",
      "default": "./testing/github.mjs"
    },
    "./network": {
      "types": "./testing/network.d.mts",
      "default": "./testing/network.mjs"
    },
    "./d1": {
      "types": "./testing/d1.d.mts",
      "default": "./testing/d1.mjs"
    },
    "./access": {
      "types": "./testing/access.d.mts",
      "default": "./testing/access.mjs"
    },
    "./islands": {
      "types": "./vite/islands.d.mts",
      "default": "./vite/islands.mjs"
    },
    "./vite/site-script": {
      "types": "./vite/site-script.d.mts",
      "default": "./vite/site-script.mjs"
    },
    "./vite/dev-toolbar": {
      "types": "./vite/dev-toolbar.d.mts",
      "default": "./vite/dev-toolbar.mjs"
    }
  },
  "bin": {
    "devkit-bootstrap": "./bin/bootstrap.mjs",
    "devkit-check-trailers": "./bin/check-trailers.mjs",
    "devkit-conformance": "./bin/conformance.mjs",
    "devkit-family": "./bin/family.mjs",
    "devkit-live": "./bin/live.mjs",
    "devkit-mutation-report": "./bin/mutation-report.mjs",
    "devkit-no-bloat": "./bin/no-bloat.mjs",
    "devkit-route-weight": "./bin/route-weight.mjs",
    "devkit-worker-size": "./bin/worker-size.mjs"
  },
  "files": [
    "bin",
    "testing",
    "vite",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
