{
  "name": "@dustinedwards/devkit",
  "version": "0.49.0",
  "private": true,
  "description": "Shared tooling for the Dustin Edwards repositories. As a package: the shared test helpers and the shared checks, installed by git tag. The Renovate policy and the reusable workflows in this repository are not part of the package.",
  "license": "MIT",
  "bin": {
    "devkit-a11y": "./bin/a11y.mjs",
    "devkit-bootstrap": "./bin/bootstrap.mjs",
    "devkit-check-trailers": "./bin/check-trailers.mjs",
    "devkit-conformance": "./bin/conformance.mjs",
    "devkit-console": "./bin/console.mjs",
    "devkit-css-vars": "./bin/css-vars.mjs",
    "devkit-db-migrate": "./bin/db-migrate.mjs",
    "devkit-destructive": "./bin/destructive.mjs",
    "devkit-fetch-fonts": "./bin/fetch-fonts.mjs",
    "devkit-gates": "./bin/gates.mjs",
    "devkit-live": "./bin/live.mjs",
    "devkit-migrations": "./bin/migrations.mjs",
    "devkit-mutation-report": "./bin/mutation-report.mjs",
    "devkit-no-bloat": "./bin/no-bloat.mjs",
    "devkit-ops-audit": "./bin/ops-audit.mjs",
    "devkit-route-weight": "./bin/route-weight.mjs",
    "devkit-secrets": "./bin/secrets.mjs",
    "devkit-shared": "./bin/shared.mjs",
    "devkit-size-budget": "./bin/size-budget.mjs",
    "devkit-test-assertions": "./bin/test-assertions.mjs",
    "devkit-tokens": "./bin/tokens.mjs",
    "devkit-verify-deploy": "./bin/verify-deploy.mjs",
    "devkit-warm": "./bin/warm.mjs",
    "devkit-worker-size": "./bin/worker-size.mjs"
  },
  "files": [
    "bin",
    "claude",
    "lint",
    "node",
    "stryker",
    "testing",
    "vite",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./node": {
      "types": "./node/index.d.mts",
      "default": "./node/index.mjs"
    },
    "./node/syntax": {
      "types": "./node/syntax.d.mts",
      "default": "./node/syntax.mjs"
    },
    "./github": {
      "types": "./testing/github.d.mts",
      "default": "./testing/github.mjs"
    },
    "./network": {
      "types": "./testing/network.d.mts",
      "default": "./testing/network.mjs"
    },
    "./d1": {
      "types": "./testing/d1.d.mts",
      "default": "./testing/d1.mjs"
    },
    "./access": {
      "types": "./testing/access.d.mts",
      "default": "./testing/access.mjs"
    },
    "./oxlint": {
      "types": "./lint/oxlint.d.mts",
      "default": "./lint/oxlint.mjs"
    },
    "./oxfmt": {
      "types": "./lint/oxfmt.d.mts",
      "default": "./lint/oxfmt.mjs"
    },
    "./islands": {
      "types": "./vite/islands.d.mts",
      "default": "./vite/islands.mjs"
    },
    "./vite/site-script": {
      "types": "./vite/site-script.d.mts",
      "default": "./vite/site-script.mjs"
    },
    "./vite/dev-toolbar": {
      "types": "./vite/dev-toolbar.d.mts",
      "default": "./vite/dev-toolbar.mjs"
    },
    "./stryker": {
      "types": "./stryker/chunked.d.mts",
      "default": "./stryker/chunked.mjs"
    },
    "./migration-scan": {
      "types": "./bin/migration-scan.d.mts",
      "default": "./bin/migration-scan.mjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test \"test/*.test.mjs\"",
    "contract": "node scripts/fakes-contract.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
