{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "build-defines.d.ts",
    "bin/*.mjs",
    "scripts/*.mjs",
    "testing/*.mjs",
    "lint/*.mjs",
    "node/*.mjs",
    "stryker/*.mjs",
    "vite/*.mjs",
    "drill/*.mjs",
    "*.mjs"
  ]
}
